+  async createTigerSlotRound(userId: number, invest: string | number, choose: number) {
+    const game = await this.findByAlias('tiger_slot');
+    if (!game || game.status !== 1) {
+      throw new Error('Game not found');
+    }
+
+    const amount = MoneyUtil.toDecimal(invest);
+    const minLimit = new Prisma.Decimal(game.minLimit.toString());
+    const maxLimit = new Prisma.Decimal(game.maxLimit.toString());
+    if (amount.lessThanOrEqualTo(0) || amount.lessThan(minLimit) || amount.greaterThan(maxLimit)) {
+      throw new Error('Please follow the investment limits for this game');
+    }
+
+    const probabilities = this.readNumberArray(game.probableWin);
+    const random = Math.floor(Math.random() * 100) + 1;
+    let winStatus = 3;
+
+    if (random < (probabilities[0] ?? 0)) {
+      winStatus = 0;
+    } else if (random < (probabilities[0] ?? 0) + (probabilities[1] ?? 0)) {
+      winStatus = 1;
+    } else if (
+      random <
+      (probabilities[0] ?? 0) +
+        (probabilities[1] ?? 0) +
+        (probabilities[3] ?? 0)
+    ) {
+      winStatus = 2;
+    }
+
+    const result = this.createNumberSlotResult(choose, winStatus);
+
+    return this.prisma.$transaction(async (tx) => {
+      const runningRound = await tx.gameLog.findFirst({
+        where: { userId, gameId: Number(game.id), status: 0 },
+      });
+      if (runningRound) {
+        throw new Error('1 game is in-complete. Please wait');
+      }
+
+      const user = await tx.user.findUniqueOrThrow({
+        where: { id: BigInt(userId) },
+      });
+      const currentBalance = new Prisma.Decimal(user.balance.toString());
+      if (currentBalance.lessThan(amount)) {
+        throw new Error('Insufficient balance');
+      }
+
+      const nextBalance = currentBalance.minus(amount);
+      await tx.user.update({
+        where: { id: BigInt(userId) },
+        data: { balance: nextBalance },
+      });
+
+      const gameLog = await tx.gameLog.create({
+        data: {
+          userId,
+          gameId: Number(game.id),
+          userSelect: String(choose),
+          result: JSON.stringify(result),
+          status: 0,
+          invest: amount,
+          winAmo: new Prisma.Decimal('0'),
+          winStatus,
+          gameName: game.name ?? 'Tiger Luck Slot',
+        },
+      });
+
+      await tx.transaction.create({
+        data: {
+          userId,
+          amount,
+          charge: new Prisma.Decimal('0'),
+          postBalance: nextBalance,
+          trxType: '-',
+          trx: `BET-${gameLog.id}`,
+          details: `Invest to ${game.name ?? 'Tiger Luck Slot'}`,
+          remark: 'invest',
+        },
+      });
+
+      return {
+        gameId: Number(gameLog.id),
+        number: result,
+        win: winStatus,
+        balance: nextBalance.toFixed(8),
+      };
+    });
+  }
+
+  async settleTigerSlot(userId: number, gameLogId: number) {
+    const game = await this.findByAlias('tiger_slot');
+    if (!game) {
+      throw new Error('Game not found');
+    }
+
+    return this.prisma.$transaction(async (tx) => {
+      const gameLog = await tx.gameLog.findFirst({
+        where: {
+          id: BigInt(gameLogId),
+          userId,
+          gameId: Number(game.id),
+          status: 0,
+        },
+      });
+      if (!gameLog) {
+        throw new Error('Game Logs not found');
+      }
+
+      const levels = this.readNumberArray(game.level);
+      const level = gameLog.winStatus ?? 0;
+      const percentage = level > 0 ? new Prisma.Decimal(String(levels[level - 1] ?? 0)) : new Prisma.Decimal('0');
+      const payout = new Prisma.Decimal(gameLog.invest.toString()).mul(percentage).div(100);
+      const user = await tx.user.findUniqueOrThrow({
+        where: { id: BigInt(userId) },
+      });
+      const nextBalance = new Prisma.Decimal(user.balance.toString()).plus(payout);
+
+      await tx.user.update({
+        where: { id: BigInt(userId) },
+        data: { balance: nextBalance },
+      });
+
+      const updated = await tx.gameLog.update({
+        where: { id: gameLog.id },
+        data: { status: 1, winAmo: payout },
+      });
+
+      if (payout.greaterThan(0)) {
+        await tx.transaction.create({
+          data: {
+            userId,
+            amount: payout,
+            charge: new Prisma.Decimal('0'),
+            postBalance: nextBalance,
+            trxType: '+',
+            trx: `WIN-${updated.id}`,
+            details: `${percentage}% Win bonus of Tiger Luck Slot Game ${level} Time`,
+            remark: 'win_bonus',
+          },
+        });
+      }
+
+      return {
+        gameId: Number(updated.id),
+        result: this.parseNumberResult(updated.result),
+        win: level,
+        won: payout.greaterThan(0),
+        balance: nextBalance.toFixed(8),
+      };
+    });
+  }
